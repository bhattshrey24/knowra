# Knowra environment variables. Copy to .env.local and fill in real values.
# NEVER commit .env* with real secrets. Values here are placeholders / names only.

# --- Supabase (public: safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# --- Supabase (SERVER ONLY — never expose to the client) ---
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Secret that enables POST /api/admin/seed-taxonomy to load the shared taxonomy
# seed into the DB (idempotent). Leave unset to disable the route entirely.
# SEED_TOKEN=""

# --- LLM provider (SERVER ONLY) ---
# Choose the backend: "ollama" (local, free, offline), "gemini" (+ key), or
# "mock" (default — free, no setup). The app depends only on the LLMProvider
# interface, so switching here changes nothing in the app's core logic.
LLM_PROVIDER="mock"

# --- Ollama (local) --- requires a running `ollama serve` + a pulled model.
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_MODEL="llama3.2"          # any pulled model; smaller = faster on CPU
# OLLAMA_TIMEOUT_MS="40000"

# --- Gemini (cloud) ---
# Free Google AI Studio key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""
# Optional model override (default gemini-flash-lite-latest — fast + less
# congested than gemini-3.8-flash). GET /v1beta/models lists what your key can use.
# GEMINI_MODEL="gemini-flash-lite-latest"
# GEMINI_TIMEOUT_MS="30000"

# --- Optional: user-supplied keys (later phase) ---
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
