# Knowra environment variables. Copy to .env.local and fill in real values.
# NEVER commit .env* with real secrets. Values here are placeholders / names only.

# --- Supabase (public: safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# --- Supabase (SERVER ONLY — never expose to the client) ---
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- LLM provider (SERVER ONLY) ---
# "mock" (default) runs free with no key. Set to "gemini" AND add a real key to
# use Google Gemini Flash. The app depends only on the LLMProvider interface.
LLM_PROVIDER="mock"
# Free Google AI Studio key for Gemini Flash: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""

# --- Optional: user-supplied keys (later phase) ---
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
